{
  "$description": "Design tokens of the Subux color theme. Read COLOR-THEME.md first; its section 0 specifies how to turn these tokens into CSS, native assets, or terminal styles. Format: W3C Design Tokens Community Group ($value, $type, $description, $extensions; $type is inherited from the group) with one convention: a plain $value applies to both light and dark mode, while a $value of the form {\"light\": ..., \"dark\": ...} differs per mode. Values are final (hex, px, ms); nothing needs resolving. Alpha colors are 8-digit hex (#RRGGBBAA). CSS variable name = --sx- + the token path with '.' replaced by '-' (color.status.success.fg -> --sx-color-status-success-fg); the palette group is never emitted or used directly.",

  "palette": {
    "$type": "color",
    "$description": "Raw scale that the semantic tokens are derived from. UI never uses it directly; add a semantic token instead.",
    "sky": {
      "200":   { "$value": "#c2e7ff", "$description": "Primary pastel fill" },
      "300":   { "$value": "#a3d9ff", "$description": "Primary hover fill" },
      "400":   { "$value": "#7fcfff", "$description": "Dark-mode text link and focus ring" },
      "500":   { "$value": "#3ba3d9", "$description": "Mid sky reference (2.7:1 on gray.50, below AA: reference only)" },
      "600":   { "$value": "#2b8cbf", "$description": "Light-mode focus ring and footnote link hover" },
      "700":   { "$value": "#1f6f9a", "$description": "Darkened sky for text-only links on light, 5.3:1 on gray.50" },
      "xterm": { "$value": "#afd7ff", "$description": "xterm-256 index 153, cube color nearest sky.200" }
    },
    "peach": {
      "200":   { "$value": "#ffdac2", "$description": "Exact complement of sky.200" },
      "300":   { "$value": "#ffc9a3", "$description": "Exact complement of sky.300" },
      "xterm": { "$value": "#ffd7af", "$description": "xterm-256 index 223, complement of index 153" }
    },
    "slate": {
      "700":   { "$value": "#33434c", "$description": "Brand mark on light background" }
    },
    "gray": {
      "50":    { "$value": "#fafafa", "$description": "Light-mode page background" },
      "200":   { "$value": "#e4e4e4", "$description": "xterm-256 index 254; light-mode neutral chip" },
      "250":   { "$value": "#dddddd", "$description": "Light-mode selection text" },
      "300":   { "$value": "#ececec", "$description": "Dark-mode body text" },
      "400":   { "$value": "#a3a3a3", "$description": "Dark-mode muted text, 7.1:1 on gray.900" },
      "500":   { "$value": "#666666", "$description": "Light-mode muted text" },
      "700":   { "$value": "#3a3a3a", "$description": "Dark-mode neutral chip" },
      "800":   { "$value": "#262626", "$description": "xterm-256 index 235; terminal pill text" },
      "850":   { "$value": "#1f1f1f", "$description": "Light-mode body text and pill foreground" },
      "900":   { "$value": "#171717", "$description": "Light-mode selection background and dark-mode page background" }
    },
    "white":   { "$value": "#ffffff" },
    "black":   { "$value": "#000000" }
  },

  "color": {
    "$type": "color",
    "$description": "Semantic colors. Fills (primary, accent, chip-neutral) always pair with their on-* token and are never used as text. Status tokens have fg (text, icon, border) and soft (background) only.",

    "bg":             { "$value": { "light": "#fafafa", "dark": "#171717" }, "$description": "Page background" },
    "bg-elevated":    { "$value": { "light": "#ffffffb8", "dark": "#1f1f1fb8" }, "$description": "Sticky header, floating panel; pair with backdrop-filter blur(blur.md)" },
    "surface-muted":  { "$value": { "light": "#0000000a", "dark": "#ffffff0f" }, "$description": "Code block, table header, callout, series box, hover background of ghost buttons" },
    "border":         { "$value": { "light": "#00000014", "dark": "#ffffff1f" }, "$description": "Every line: 1px solid; 3px on blockquote and callout left edge" },

    "text":           { "$value": { "light": "#1f1f1f", "dark": "#ececec" }, "$description": "Body and headings. 15.8:1 / 15.2:1 on bg" },
    "text-muted":     { "$value": { "light": "#666666", "dark": "#a3a3a3" }, "$description": "Dates, labels, blockquote, inactive tab, strikethrough, empty state. 5.5:1 / 7.1:1 on bg" },
    "selection-bg":   { "$value": { "light": "#171717", "dark": "#dddddd" }, "$description": "::selection background (inverted)" },
    "selection-text": { "$value": { "light": "#dddddd", "dark": "#171717" }, "$description": "::selection text" },

    "primary":        { "$value": "#c2e7ff", "$description": "FILL only: link pill, primary button, active tab underline, selected row, keycap. Same in both modes. Never a text color (1.2:1 on light bg)" },
    "primary-hover":  { "$value": "#a3d9ff", "$description": "Hover of primary fills" },
    "on-primary":     { "$value": "#1f1f1f", "$description": "Text on primary and primary-hover: 12.7:1 / 10.9:1" },

    "accent":         { "$value": "#ffdac2", "$description": "FILL only, for a second workspace or area. Not mixed with primary on one screen" },
    "accent-hover":   { "$value": "#ffc9a3", "$description": "Hover of accent fills" },
    "on-accent":      { "$value": "#1f1f1f", "$description": "Text on accent and accent-hover: 12.6:1 / 11.1:1" },

    "chip-neutral":   { "$value": { "light": "#e4e4e4", "dark": "#3a3a3a" }, "$description": "Pill that belongs to no area, e.g. an outer breadcrumb" },
    "on-chip-neutral":{ "$value": { "light": "#1f1f1f", "dark": "#ececec" }, "$description": "Text on chip-neutral: 13.0:1 / 9.6:1" },

    "link":           { "$value": { "light": "#1f6f9a", "dark": "#7fcfff" }, "$description": "Text-only link when a pill is impossible: 5.3:1 / 10.5:1 on bg" },
    "focus-ring":     { "$value": { "light": "#2b8cbf", "dark": "#7fcfff" }, "$description": ":focus-visible outline 2px, offset 2px. 3.6:1 on light bg meets non-text 3:1" },
    "brand-mark":     { "$value": { "light": "#33434c", "dark": "#c2e7ff" }, "$description": "Monochrome brand icon via currentColor" },

    "status": {
      "$description": "fg = text, icon, border; soft = background. Icons: success ✓, warning !, danger ✗, info i.",
      "success": {
        "fg":   { "$value": { "light": "#116329", "dark": "#3fb950" } },
        "soft": { "$value": { "light": "#dafbe1", "dark": "#3fb95026" } }
      },
      "warning": {
        "fg":   { "$value": { "light": "#9a6700", "dark": "#d29922" } },
        "soft": { "$value": { "light": "#fff8c5", "dark": "#d2992226" } }
      },
      "danger": {
        "fg":   { "$value": { "light": "#cf222e", "dark": "#ff7b72" } },
        "soft": { "$value": { "light": "#ffebe9", "dark": "#ff7b7226" } }
      },
      "info": {
        "fg":   { "$value": { "light": "#0550ae", "dark": "#79c0ff" } },
        "soft": { "$value": { "light": "#ddf4ff", "dark": "#79c0ff26" } }
      }
    },

    "row": {
      "$description": "Row tone tokens for table rows. Values repeat other tokens so they can be read without lookup.",
      "normal":  { "$value": { "light": "#1f1f1f", "dark": "#ececec" }, "$description": "= color.text" },
      "pending": { "$value": { "light": "#9a6700", "dark": "#d29922" }, "$description": "= color.status.warning.fg" },
      "failed":  { "$value": { "light": "#cf222e", "dark": "#ff7b72" }, "$description": "= color.status.danger.fg" },
      "done":    { "$value": { "light": "#666666", "dark": "#a3a3a3" }, "$description": "= color.text-muted" }
    },

    "code": {
      "$description": "Syntax highlighting. Light = GitHub light family; dark = highlight.js github-dark. Block background is color.surface-muted, border is color.border.",
      "text":        { "$value": { "light": "#24292f", "dark": "#c9d1d9" } },
      "comment":     { "$value": { "light": "#57606a", "dark": "#8b949e" } },
      "keyword":     { "$value": { "light": "#cf222e", "dark": "#ff7b72" }, "$description": "keyword, selector-tag, subst" },
      "number":      { "$value": { "light": "#0550ae", "dark": "#79c0ff" }, "$description": "number, literal, variable, attr, attribute, meta, symbol" },
      "string":      { "$value": { "light": "#0a7f5a", "dark": "#a5d6ff" }, "$description": "string, doctag, regexp" },
      "title":       { "$value": { "light": "#8250df", "dark": "#d2a8ff" }, "$description": "title, section, selector-id" },
      "type":        { "$value": { "light": "#953800", "dark": "#ffa657" }, "$description": "type, class title" },
      "tag":         { "$value": { "light": "#116329", "dark": "#7ee787" }, "$description": "name, tag" },
      "builtin":     { "$value": { "light": "#b35900", "dark": "#ffa657" }, "$description": "built_in, bullet, code" },
      "deletion-fg": { "$value": { "light": "#82071e", "dark": "#ffdcd7" } },
      "deletion-bg": { "$value": { "light": "#ffebe9", "dark": "#67060c" } },
      "addition-fg": { "$value": { "light": "#116329", "dark": "#aff5b4" } },
      "addition-bg": { "$value": { "light": "#dafbe1", "dark": "#033a16" } },
      "diagram-bg":  { "$value": { "light": "#f8fafc", "dark": "#ffffff0f" }, "$description": "mermaid container; dark = color.surface-muted" }
    },

    "callout": {
      "$description": "Document callouts (Tailwind default 500 shades). Only a 3px left border and a bold title, same in both modes. Never body text or wide fills.",
      "note": { "$value": "#3b82f6" }, "tip": { "$value": "#22c55e" }, "important": { "$value": "#a855f7" }, "warning": { "$value": "#eab308" },
      "caution": { "$value": "#ef4444" }, "tldr": { "$value": "#06b6d4" }, "info": { "$value": "#6366f1" }, "todo": { "$value": "#f97316" },
      "hint": { "$value": "#14b8a6" }, "success": { "$value": "#10b981" }, "question": { "$value": "#8b5cf6" }, "missing": { "$value": "#f43f5e" },
      "error": { "$value": "#dc2626" }, "bug": { "$value": "#ec4899" }, "example": { "$value": "#78716c" }, "cite": { "$value": "#6b7280" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Shadow tokens. CSS: offsetX offsetY blur color (spread is 0 and omitted).",
    "sm": { "$value": { "light": { "offsetX": "0", "offsetY": "1px", "blur": "2px",  "spread": "0", "color": "#0000000a" }, "dark": { "offsetX": "0", "offsetY": "1px", "blur": "2px",  "spread": "0", "color": "#00000066" } }, "$description": "Hovered pill" },
    "md": { "$value": { "light": { "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "0", "color": "#00000014" }, "dark": { "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "0", "color": "#00000080" } }, "$description": "Card, popover" },
    "lg": { "$value": { "light": { "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0", "color": "#0000001f" }, "dark": { "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0", "color": "#00000099" } }, "$description": "Modal" }
  },

  "font": {
    "$type": "fontFamily",
    "$description": "Font family tokens. CSS: join with ', ', quote names that contain spaces.",
    "sans": { "$value": ["Pretendard Variable", "Pretendard", "Subux Gothic Fallback", "-apple-system", "BlinkMacSystemFont", "system-ui", "Roboto", "Helvetica Neue", "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"] }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Border radius tokens",
    "sm": { "$value": "8px",  "$description": "Inline link pill, inline code" },
    "md": { "$value": "12px", "$description": "Button, card, code block, table, callout" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "20px" }
  },

  "space": {
    "$type": "dimension",
    "$description": "Spacing scale (8px unit)",
    "1": { "$value": "8px" },  "2": { "$value": "16px" }, "3": { "$value": "24px" }, "4": { "$value": "32px" }, "5": { "$value": "40px" },
    "6": { "$value": "48px" }, "7": { "$value": "56px" }, "8": { "$value": "64px" }, "9": { "$value": "72px" }, "10": { "$value": "80px" }
  },

  "duration": {
    "$type": "duration",
    "$description": "Transition durations; always paired with easing.standard",
    "fast":   { "$value": "150ms", "$description": "Hover, focus" },
    "normal": { "$value": "250ms" },
    "slow":   { "$value": "350ms" }
  },

  "easing": {
    "$type": "cubicBezier",
    "$description": "CSS: cubic-bezier(0.4, 0, 0.2, 1)",
    "standard": { "$value": [0.4, 0, 0.2, 1], "$description": "The only easing curve" }
  },

  "blur": {
    "$type": "dimension",
    "$description": "Backdrop blur radii",
    "sm": { "$value": "8px" }, "md": { "$value": "16px", "$description": "backdrop-filter for color.bg-elevated" }, "lg": { "$value": "24px" }
  },

  "size": {
    "$type": "dimension",
    "touch-target-min": { "$value": "44px", "$description": "Minimum tappable size" }
  }
}
